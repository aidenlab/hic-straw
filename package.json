{
  "name": "hic-straw",
  "version": "2.1.4",
  "description": "Utilities for reading .hic contact matrix files",
  "type": "module",
  "main": "dist/hic-straw.cjs.js",
  "module": "dist/hic-straw.esm.js",
  "exports": {
    ".": {
      "import": "./dist/hic-straw.esm.js",
      "require": "./dist/hic-straw.cjs.js"
    },
    "./node": "./src/io/nodeLocalFile.mjs"
  },
  "files": [
    "dist/**",
    "src/**",
    "cli.js"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build --config vite.config.lib.js",
    "preview": "vite preview",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "test": "mocha -ui tdd"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "chai": "^4.2.0",
    "mocha": "^10.2.0",
    "vite": "^6.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aidenlab/hic-straw.git"
  },
  "keywords": [
    "hic",
    "contact-matrix",
    "juicebox"
  ],
  "author": "Jim Robinson <igv-team@broadinstitute.org> (https://igv.org)",
  "contributors": [
    "Jim Robinson <igv-team@broadinstitute.org> (https://igv.org)",
    "Douglass Turner (https://github.com/turner)"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/aidenlab/hic-straw/issues"
  },
  "bin": {
    "straw": "cli.js"
  },
  "homepage": "https://github.com/aidenlab/hic-straw#readme"
}
